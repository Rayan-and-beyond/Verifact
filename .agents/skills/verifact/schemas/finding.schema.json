{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifact.local/schemas/finding.schema.json",
  "title": "Verifact finding",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "state", "category", "confidence", "claim", "conditions", "evidence", "limitations", "analyst", "createdUtc", "updatedUtc"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "id": {"type": "string", "pattern": "^VF-[0-9]{4}-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 3},
    "state": {"enum": ["candidate", "validated", "rejected", "inconclusive"]},
    "category": {"type": "string", "minLength": 1},
    "severity": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "informational", null]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "claim": {"type": "string", "minLength": 10},
    "impact": {"type": ["string", "null"]},
    "analyst": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "statement", "status", "evidenceRefs", "researchRefs"],
        "properties": {
          "kind": {"enum": ["host-fact", "external-prerequisite"]},
          "statement": {"type": "string", "minLength": 3},
          "status": {"enum": ["established", "missing", "unknown"]},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "researchRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "runKind", "locator", "supports", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "runKind": {"enum": ["events", "posture"]},
          "locator": {"type": "string", "minLength": 1},
          "supports": {"type": "string", "minLength": 3},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "accessedUtc", "supports"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "accessedUtc": {"type": "string", "format": "date-time"},
          "supports": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "remediation": {"type": "array", "items": {"type": "string"}},
    "createdUtc": {"type": "string", "format": "date-time"},
    "updatedUtc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
